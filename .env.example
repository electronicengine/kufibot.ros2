# Local-only Verasist credentials for a desktop/WSL simulation.
# Copy this file to .env, then fill in the token.  Never commit .env.
VERASIST_API_TOKEN=

# Set this only if your Verasist deployment does not use the configured URL.
# VERASIST_API_ENDPOINT=https://your-verasist-endpoint

# SDK-standard names are also accepted (legacy names above take precedence).
# VERASIST_API_URL=https://your-verasist-endpoint
# VERASIST_API_KEY=
# VERASIST_TRIGGER_UUID=

# WSLg uses pulse:default automatically when PULSE_SERVER is set.
# MIC_ALSA_DEVICE=pulse:default
# SPEAKER_ALSA_DEVICE=pulse:default
