<?xml version="1.0"?>
<package format="3">
  <name>kufibot_navigation</name><version>0.1.0</version>
  <description>Bounded sensor-driven navigation and drive arbitration.</description>
  <maintainer email="y.bulbul@hotmail.com">kufi</maintainer><license>BSD-2-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>kufibot_interfaces</exec_depend><exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
